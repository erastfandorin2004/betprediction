NODE_ENV=development

DATABASE_URL=postgresql://aiscore:aiscore@localhost:5432/aiscore
REDIS_URL=redis://localhost:6379

# Football-Data.org

# laozhang (老张) — OpenAI-compatible LLM aggregator for the prediction ensemble
# https://docs.laozhang.ai
LAOZHANG_API_KEY=
LAOZHANG_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_MODELS=gpt-5.1,grok-4,claude-opus-4-8,deepseek-chat

# Авто-анализ всех матчей. По умолчанию ВЫКЛ — прогноз считается только вручную
# по кнопке «Сделать анализ» в карточке матча. true — включить фоновую генерацию.
AUTO_PREDICTIONS=false

# Ingest schedule (cron expressions)
INGEST_LEAGUES_CRON=0 2 * * *
INGEST_FIXTURES_CRON=*/5 * * * *

API_FOOTBALL_KEY=70b4d15b2097610b252d2d2d56378489
