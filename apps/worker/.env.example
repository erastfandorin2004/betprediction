NODE_ENV=development

DATABASE_URL=postgresql://aiscore:aiscore@localhost:5432/aiscore
REDIS_URL=redis://localhost:6379

# Football-Data.org
FOOTBALL_DATA_API_KEY=

# laozhang (老张) — OpenAI-compatible LLM aggregator for the prediction ensemble
# https://docs.laozhang.ai
LAOZHANG_API_KEY=
LAOZHANG_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_MODELS=gpt-5.5,claude-opus-4-8,deepseek-v4

# Ingest schedule (cron expressions)
INGEST_LEAGUES_CRON=0 2 * * *
INGEST_FIXTURES_CRON=*/5 * * * *
