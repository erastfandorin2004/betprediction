NODE_ENV=development
PORT=3001

# JWT — MUST be changed in production
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database (Docker Compose default)
DATABASE_URL=postgresql://aiscore:aiscore@localhost:5432/aiscore

# Redis (Docker Compose default)
REDIS_URL=redis://localhost:6379

# Football-Data.org — free at https://www.football-data.org/client/register
# Free tier: 10 req/min, top 12 competitions
FOOTBALL_DATA_API_KEY=

# OpenRouter (added in Step 4 — LLM predictions)
OPENROUTER_API_KEY=

# RapidAPI → FlashLive Sports — H2H/form/lineups/stats/summary.
# BASIC plan = 500 requests/MONTH per key. Pool several free accounts by listing
# keys comma-separated; the adapter auto-rotates when one hits its monthly quota.
#   RAPIDAPI_FOOTBALL_KEY=key1,key2,key3
RAPIDAPI_FOOTBALL_KEY=

# API-Football direct (api-sports.io) — free 100 req/day, resets DAILY.
# Sign up: https://dashboard.api-football.com/register (no card). Key under "My Access".
API_FOOTBALL_KEY=

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Stripe (added in Step 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# laozhang (老张) LLM
LAOZHANG_API_KEY=
LAOZHANG_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_MODELS=gpt-5.1,claude-opus-4-7,deepseek-v3.2-exp,gemini-2.5-flash-nothinking
TOKENS_ENABLED=false
AI_PREDICTION_COST=5

# Live bookmaker odds — the-odds-api.com (free tier)
THE_ODDS_API_KEY=
