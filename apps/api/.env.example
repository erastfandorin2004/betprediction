NODE_ENV=development
PORT=3001

# JWT — MUST be changed in production
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database (added in Step 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiscore

# Redis (added in Step 2)
REDIS_URL=redis://localhost:6379

# OpenRouter (added in Step 4)
OPENROUTER_API_KEY=

# Sports data provider (added in Step 2)
FOOTBALL_DATA_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# Stripe (added in Step 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
